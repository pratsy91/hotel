NODE_ENV=development
PORT=3000
# Host port published by Docker Compose. The API process still listens on PORT.
API_PORT=3000
LOG_LEVEL=info

# Redis connection string. Inside Docker Compose this is redis://redis:6379.
REDIS_URL=redis://127.0.0.1:6379

# Temporal frontend gRPC address.
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hotel-offer-task-queue

# Base URL of this API, used by the worker to call the mock supplier routes
# and by the API health check. No trailing slash.
# Docker API container: http://127.0.0.1:3000
# Docker worker container: http://api:3000
SUPPLIER_BASE_URL=http://127.0.0.1:3000
